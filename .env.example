# ASI1 API key: https://asi1.ai/dashboard/api-keys
ASI1_API_KEY=
ASI1_MODEL=asi1

# Seeds fix each agent's address and act as its private key. Use long random phrases and keep them secret.
# A specialist seed left empty is derived privately from JAANCH_SEED.
JAANCH_SEED=
JAANCH_DOMAIN_SEED=
JAANCH_PATTERN_SEED=
JAANCH_REPUTATION_SEED=

# 1 = connect to Agentverse through mailboxes (needed for ASI:One). 0 = local only.
JAANCH_MAILBOX=1
JAANCH_PORT=8000

# Document Upload & Offer Letter Analysis Configuration
JAANCH_MAX_UPLOAD_MB=15
JAANCH_DOC_DB_PATH=data/jaanch_documents.db
JAANCH_UPLOAD_DIR=data/uploads

# Optional: Path to Tesseract OCR executable for scanned documents/images (e.g., C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
