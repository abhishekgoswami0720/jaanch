# ASI1 API key: https://asi1.ai/dashboard/api-keys
ASI1_API_KEY=
ASI1_MODEL=asi1

# Seeds fix each agent's address. Use three different long random phrases and keep them secret.
JAANCH_SEED=
JAANCH_DOMAIN_SEED=
JAANCH_PATTERN_SEED=
JAANCH_REPUTATION_SEED=

# 1 = connect to Agentverse through mailboxes (needed for ASI:One). 0 = local only.
JAANCH_MAILBOX=1
JAANCH_PORT=8000
